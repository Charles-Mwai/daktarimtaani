# Copy this to .env and customize for local/dev
# JWT secret used to sign role-specific session tokens
JWT_SECRET=replace_with_a_long_random_secret

# Node environment
NODE_ENV=development

# Neon PostgreSQL connection strings
DATABASE_URL=postgresql://user:password@pooler-host/dbname?sslmode=require
# Direct Neon endpoint used by Prisma migrations
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Next.js specific (optional)
# PORT=3000
